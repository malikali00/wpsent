# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://commexdb:99SHAO0tSJW2gvg6@cluster0.x1ituns.mongodb.net/?appName=Cluster0

# Port (Railway sets this automatically, default 3000)
PORT=3000

# Single-user mode: set to true to block new registrations after first user
# Perfect for personal use — anyone who tries to register sees a "server full" page
SINGLE_USER=true

# Public links shown on the site (Self-host / GitHub buttons, footer, contact)
GITHUB_URL=https://github.com/your-username/wpsent
INSTAGRAM_URL=https://instagram.com/your-handle
CONTACT_EMAIL=you@example.com
